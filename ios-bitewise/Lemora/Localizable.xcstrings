    "I’ll learn your taste, then match it with the best grocery deals near you.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’apprendrai tes goûts, puis je les jumellerai aux meilleures aubaines d’épicerie près de chez toi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenderé tus gustos y los combinaré con las mejores ofertas de supermercado cerca de ti."
          }
        }
      }
    },
    "I’ll plan your list around this.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je planifierai ta liste en fonction de ça."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planearé tu lista según esto."
          }
        }
      }
    },
    "I’ll size every recipe, your grocery list and your budget for this many people.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ajusterai chaque recette, ta liste d’épicerie et ton budget pour ce nombre de personnes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustaré cada receta, tu lista de compras y tu presupuesto para esta cantidad de personas."
          }
        }
