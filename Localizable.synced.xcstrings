          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça me sert à trouver les épiceries et les aubaines près de chez toi."
          }
        }
      }
    },
    "I'll find lighter meals that still fill you up." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voy a encontrar comidas más ligeras que igual llenan."
