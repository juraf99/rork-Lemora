          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vais trouver des repas plus légers qui rassasient."
          }
        }
      }
    },
    "I’ll learn your taste, then match it with the best grocery deals near you." : {
      "extractionState" : "manual",
