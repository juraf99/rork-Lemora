          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement, sauf annulation au moins 24 heures avant la fin de la période. Gère ou annule en tout temps dans les réglages de ton App Store."
          }
        }
      }
