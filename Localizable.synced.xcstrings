    "I use this to find stores and deals near you." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo uso para encontrar tiendas y ofertas cerca de ti."
